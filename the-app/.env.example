# Copy this file to .env and fill in only the keys you need.
# Every key is optional: without them the app runs in demo mode.
# Setup steps for each one: ../setup-guide/setup-and-integrations.md

# OpenAI — AI basket planner (falls back to the local budget engine)
VITE_OPENAI_API_KEY=

# Supabase — sign-in and cloud sync (falls back to localStorage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# YNAB — budget connection (falls back to demo mode)
VITE_YNAB_CLIENT_ID=
